# 마케팅 OS 대시보드 · systemd 상주 유닛
# deploy.sh 가 __PATH__ 와 __NODE__ 를 실제 값으로 바꿔 설치한다.
#
# 127.0.0.1 에만 바인딩한다. 외부 노출은 리버스 프록시(Caddy)가 맡는다.
# 이렇게 하면 HTTPS 종단과 인증서 갱신을 프록시가 처리하고,
# 앱은 평문 HTTP 를 로컬에서만 열어 공격면이 좁아진다.
[Unit]
Description=Marketing OS Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__PATH__
ExecStart=__NODE__ tools/dashboard/server.mjs --host 127.0.0.1 --port 3737
Restart=always
RestartSec=5
# 표준출력을 journal 로 (journalctl -u marketing-os-dashboard -f 로 본다)
StandardOutput=journal
StandardError=journal
Environment=NODE_ENV=production
# 시간대를 한국으로 맞춘다 (업무 날짜·오늘 흐름이 KST 기준이어야 한다)
Environment=TZ=Asia/Seoul

# 최소 권한 · 앱이 만지는 곳만 쓰기 허용
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=__PATH__

[Install]
WantedBy=multi-user.target
