{
  "name": "marketing-os",
  "version": "1.0.0",
  "description": "마케팅 AI 직원 53명과 방법론 100개를 Claude Agent SDK 로 굴리는 마케팅 OS",
  "type": "module",
  "scripts": {
    "agent": "node scripts/agent-runner.mjs",
    "dashboard": "node tools/dashboard/server.mjs",
    "status": "node scripts/status-scan.mjs --open",
    "agents:list": "node scripts/agent-runner.mjs --list",
    "healthcheck": "bash scripts/healthcheck-all.sh",
    "validate": "bash scripts/validate-agents.sh && bash scripts/check-links.sh && node scripts/validate-skills.mjs",
    "drift": "bash scripts/check-org-drift.sh",
    "collect": "node scripts/collect.mjs",
    "collect:all": "node scripts/collect.mjs all",
    "setup": "bash install.sh",
    "doctor": "node scripts/doctor.mjs",
    "agents:audit": "node scripts/agent-audit.mjs",
    "validate:skills": "node scripts/validate-skills.mjs"
  },
  "keywords": [
    "claude",
    "agent-sdk",
    "marketing",
    "automation"
  ],
  "author": "이 회사 (사용자 / 대표)",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.150",
    "discord.js": "^14.26.4",
    "pg": "^8.22.0"
  }
}